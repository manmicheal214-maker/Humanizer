--- repo/.github/workflows/deploy-pages.yml	2026-09-11 06:10:48.462994669 +0000
+++ fixed/.github/workflows/deploy-pages.yml	2026-09-11 06:14:32.680143070 +0000
@@ -15,7 +15,21 @@
   cancel-in-progress: true
 
 jobs:
+  deploy-worker:
